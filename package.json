{
  "name": "yatagarrage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ブラウザ弾幕シューティング (PixiJS) — 八咫烏が花火を撃ち落とす",
  "author": "kako-jun",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\" README.md CLAUDE.md",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" README.md CLAUDE.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.8"
  }
}
